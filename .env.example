# Copy to .env and adjust as needed. All values here have working defaults in
# config/settings.py -- .env only needs to override what differs from that.

# --- Auth ---
# JWT_SECRET=change-me-to-a-stable-secret-in-production

# --- FastAPI service ---
API_HOST=127.0.0.1
API_PORT=8000

# --- FastMCP server ---
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_PATH=/mcp

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.15
OLLAMA_SEED=42

# --- ChromaDB ---
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=sezzle_policy_chunks

# --- Hybrid retrieval / reranking (optional) ---
# RETRIEVAL_RERANK_ENABLED=true

# --- LangSmith (tracing + evals, optional -- needs your own account/key) ---
# LANGSMITH_TRACING_ENABLED=true
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=sezzle-support-agent
